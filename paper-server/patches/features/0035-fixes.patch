-        // Jeweils EIN Batch-Packet pro Gruppe bauen und an die passenden Spieler schicken
-        if (!newlyHiddenBlue.isEmpty()) {
-            sendBatchHide(newlyHiddenBlue, serverPlayer ->
-                serverPlayer.getBukkitEntity().getTechhider().getHullHider().hullRegionBlue);
-        }
-        if (!newlyHiddenRed.isEmpty()) {
-            sendBatchHide(newlyHiddenRed, serverPlayer ->
-                serverPlayer.getBukkitEntity().getTechhider().getHullHider().hullRegionRed);
-        }
-
-        // Wieder sichtbare TNT sammeln
-        java.util.List<net.minecraft.world.entity.item.PrimedTnt> toShow = new java.util.ArrayList<>();
-        java.util.Iterator<Integer> it = entityLookup.keySet().iterator();
-        while (it.hasNext()) {
-            int id = it.next();
-            if (!currentlyHidden.contains(id)) {
-                net.minecraft.world.entity.item.PrimedTnt tnt = entityLookup.remove(id);
-                if (tnt != null && !tnt.isRemoved()) {
-                    toShow.add(tnt);
-                }
-                it.remove();
-            }
-        }
-
-        if (!toShow.isEmpty()) {
-            showEntitiesForPlayers(toShow);
-        }
-    }
