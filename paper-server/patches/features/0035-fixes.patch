-    private static void sendBatchHide(it.unimi.dsi.fastutil.ints.IntArrayList ids,
-                                      java.util.function.Predicate<ServerPlayer> shouldHideFor) {
-        it.unimi.dsi.fastutil.ints.IntList idList = new it.unimi.dsi.fastutil.ints.IntArrayList(ids.size());
-        for (int i = 0; i < ids.size(); i++) {
-            idList.add(ids.getInt(i));
-        }
-
-        net.minecraft.network.protocol.game.ClientboundRemoveEntitiesPacket packet =
-            new net.minecraft.network.protocol.game.ClientboundRemoveEntitiesPacket(idList);
-
-        for (ServerPlayer serverPlayer : net.minecraft.server.MinecraftServer.getServer().getPlayerList().getPlayers()) {
-            if (shouldHideFor.test(serverPlayer)) {
-                serverPlayer.connection.send(packet); // gleiches Packet-Objekt für alle passenden Spieler
-            }
-        }
-    }
