-    public static void tick() {
-        ServerLevel level = net.minecraft.server.MinecraftServer.getServer().overworld();
-        if (globalBlue == null || globalRed == null) return;
-
-        it.unimi.dsi.fastutil.ints.IntOpenHashSet currentlyHidden = new it.unimi.dsi.fastutil.ints.IntOpenHashSet();
-
-        java.util.List<net.minecraft.world.entity.item.PrimedTnt> blueTNT = getTntInRegion(level, globalBlue);
-        java.util.List<net.minecraft.world.entity.item.PrimedTnt> redTNT = getTntInRegion(level, globalRed);
-
-        // Statt sofort zu senden: IDs sammeln, die in diesem Tick NEU versteckt werden
-        it.unimi.dsi.fastutil.ints.IntArrayList newlyHiddenBlue = new it.unimi.dsi.fastutil.ints.IntArrayList();
-        it.unimi.dsi.fastutil.ints.IntArrayList newlyHiddenRed = new it.unimi.dsi.fastutil.ints.IntArrayList();
-
-        for (net.minecraft.world.entity.item.PrimedTnt tnt : blueTNT) {
-            if (unhiddenBlue.contains(tnt.blockPosition())) continue;
-
-            entityLookup.put(tnt.getId(), tnt);
-
-            if (currentlyHidden.add(tnt.getId())) {
-                newlyHiddenBlue.add(tnt.getId());
-            }
-        }
-
-        for (net.minecraft.world.entity.item.PrimedTnt tnt : redTNT) {
-            if (unhiddenRed.contains(tnt.blockPosition())) continue;
-
-            entityLookup.put(tnt.getId(), tnt);
-
-            if (currentlyHidden.add(tnt.getId())) {
-                newlyHiddenRed.add(tnt.getId());
-            }
-        }
