-    private static final java.util.Map<net.minecraft.core.SectionPos, java.util.List<net.minecraft.core.BlockPos>> pendingUpdates = new java.util.HashMap<>();
-    private static boolean flushScheduled = false;
-    private static boolean floodScheduled = false;
-    private static ServerLevel pendingLevel;
-    private static final java.util.List<net.minecraft.core.BlockPos> pendingDestroyed = new java.util.ArrayList<>();
-
-    public static void notifyBlocksDestroyed(org.bukkit.World world, java.util.Collection<net.minecraft.core.BlockPos> destroyedPositions) {
-        if (globalBlue == null && globalRed == null) return;
-
-        net.minecraft.server.level.ServerLevel level = ((org.bukkit.craftbukkit.CraftWorld) world).getHandle();
-
-        synchronized (pendingDestroyed) {
-            pendingDestroyed.addAll(destroyedPositions);
-            pendingLevel = level;
-
-            if (!floodScheduled) {
-                floodScheduled = true;
-                net.minecraft.server.MinecraftServer.getServer().execute(HullHider::processPendingFlood);
-            }
-        }
-    }
-
-    private static void processPendingFlood() {
-        java.util.List<net.minecraft.core.BlockPos> toProcess;
-        net.minecraft.server.level.ServerLevel level;
-        synchronized (pendingDestroyed) {
-            toProcess = new java.util.ArrayList<>(pendingDestroyed);
-            level = pendingLevel;
-            pendingDestroyed.clear();
-            floodScheduled = false;
-        }
-        if (toProcess.isEmpty()) return;
-
-        boolean anyInRange = false;
-        for (net.minecraft.core.BlockPos p : toProcess) {
-            if ((globalBlue != null && globalBlue.isInside(p)) ||
-                (globalRed != null && globalRed.isInside(p))) {
-                anyInRange = true;
-                break;
-            }
-        }
-        if (!anyInRange) return;
-
-        final int MAX_RADIUS = 12;
-
-        java.util.Map<net.minecraft.core.SectionPos, java.util.List<net.minecraft.core.BlockPos>> changedBySection = new java.util.HashMap<>();
-        java.util.Set<net.minecraft.core.BlockPos> visited = new java.util.HashSet<>();
-        java.util.ArrayDeque<net.minecraft.core.BlockPos> queue = new java.util.ArrayDeque<>();
-
-        java.util.Map<net.minecraft.core.BlockPos, net.minecraft.core.BlockPos> originOf = new java.util.HashMap<>();
-
-        for (net.minecraft.core.BlockPos destroyed : toProcess) {
-            boolean insideBlue = globalBlue != null && globalBlue.isInside(destroyed);
-            boolean insideRed = globalRed != null && globalRed.isInside(destroyed);
-            if (!insideBlue && !insideRed) continue;
-            if (visited.add(destroyed)) {
-                queue.add(destroyed);
-                originOf.put(destroyed, destroyed);
-            }
-        }
-
-        while (!queue.isEmpty()) {
-            net.minecraft.core.BlockPos pos = queue.poll();
-            net.minecraft.core.BlockPos origin = originOf.get(pos);
-
-            boolean insideBlue = globalBlue != null && globalBlue.isInside(pos);
-            boolean insideRed = globalRed != null && globalRed.isInside(pos);
-            if (!insideBlue && !insideRed) continue;
-
-            if (isBlockedNMS.test(level.getBlockState(pos))) continue;
-
-            boolean addedBlue = insideBlue && unhiddenBlue.add(pos);
-            boolean addedRed = insideRed && unhiddenRed.add(pos);
-
-            if (addedBlue || addedRed) {
-                net.minecraft.core.SectionPos sectionPos = net.minecraft.core.SectionPos.of(pos);
-                changedBySection.computeIfAbsent(sectionPos, k -> new java.util.ArrayList<>()).add(pos);
-            } else {
-                continue;
-            }
-
-            for (net.minecraft.core.BlockPos neighbor : java.util.List.of(
-                pos.west(), pos.east(), pos.north(), pos.south(), pos.above(), pos.below())) {
-
-                int dist = Math.abs(neighbor.getX() - origin.getX())
-                    + Math.abs(neighbor.getY() - origin.getY())
-                    + Math.abs(neighbor.getZ() - origin.getZ());
-                if (dist > MAX_RADIUS) continue;
-
-                if (visited.add(neighbor)) {
-                    queue.add(neighbor);
-                    originOf.put(neighbor, origin);
-                }
-            }
-        }
-
-        if (!changedBySection.isEmpty()) {
-            queueForBatchSend(level, changedBySection);
-        }
-    }
-
-    private static void queueForBatchSend(net.minecraft.server.level.ServerLevel level, java.util.Map<net.minecraft.core.SectionPos, java.util.List<net.minecraft.core.BlockPos>> changedBySection) {
-        synchronized (pendingUpdates) {
-            changedBySection.forEach((section, positions) ->
-                pendingUpdates.computeIfAbsent(section, k -> new java.util.ArrayList<>()).addAll(positions)
-            );
-
-            if (!flushScheduled) {
-                flushScheduled = true;
-                net.minecraft.server.MinecraftServer.getServer().execute(() -> flushPendingUpdates(level));
-            }
-        }
-    }
-
-    private static void flushPendingUpdates(net.minecraft.server.level.ServerLevel level) {
-        java.util.Map<net.minecraft.core.SectionPos, java.util.List<net.minecraft.core.BlockPos>> toSend;
-        synchronized (pendingUpdates) {
-            toSend = new java.util.HashMap<>(pendingUpdates);
-            pendingUpdates.clear();
-            flushScheduled = false;
-        }
-
-        if (toSend.isEmpty()) return;
-
-        // Betroffene Chunk-Koordinaten aus den Section-Keys ableiten, dedupliziert
-        java.util.Set<net.minecraft.world.level.ChunkPos> affectedChunks = new java.util.HashSet<>();
-        for (net.minecraft.core.SectionPos sectionPos : toSend.keySet()) {
-            affectedChunks.add(new net.minecraft.world.level.ChunkPos(sectionPos.x(), sectionPos.z()));
-        }
-
-        java.util.concurrent.CompletableFuture.delayedExecutor(200, java.util.concurrent.TimeUnit.MILLISECONDS).execute(() -> {
-            net.minecraft.server.MinecraftServer.getServer().execute(() -> {
-                for (net.minecraft.server.level.ServerPlayer serverPlayer : level.players()) {
-                    resendChunks(serverPlayer, level, affectedChunks);
-                }
-                net.minecraft.server.MinecraftServer.LOGGER.info("resent " + affectedChunks.size() + " chunks!");
-            });
-        });
-    }
-
-    private static void resendChunks(net.minecraft.server.level.ServerPlayer player, net.minecraft.server.level.ServerLevel level, java.util.Set<net.minecraft.world.level.ChunkPos> chunks) {
-        for (net.minecraft.world.level.ChunkPos chunkPos : chunks) {
-            if (!level.isLoaded(new net.minecraft.core.BlockPos(chunkPos.getMiddleBlockX(), 64, chunkPos.getMiddleBlockZ()))) {
-                continue; // Chunk nicht geladen -> nichts zu senden
-            }
-
-            net.minecraft.world.level.chunk.LevelChunk chunk = level.getChunk(chunkPos.x, chunkPos.z);
-
-            net.minecraft.network.protocol.game.ClientboundLevelChunkWithLightPacket packet =
-                new net.minecraft.network.protocol.game.ClientboundLevelChunkWithLightPacket(
-                    chunk, level.getLightEngine(), null, null
-                );
-
-            player.connection.send(packet);
-        }
-    }
-}
