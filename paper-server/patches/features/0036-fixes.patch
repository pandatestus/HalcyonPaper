diff --git a/net/minecraft/network/protocol/game/ClientboundLevelChunkPacketData.java b/net/minecraft/network/protocol/game/ClientboundLevelChunkPacketData.java
index 8c3bea820cf64b1a9e2ca038d14d18a4084a7227..844b941586df4b8f47f57b044e73e12dfb21eb00 100644
--- a/net/minecraft/network/protocol/game/ClientboundLevelChunkPacketData.java
+++ b/net/minecraft/network/protocol/game/ClientboundLevelChunkPacketData.java
@@ -44,9 +44,9 @@ public class ClientboundLevelChunkPacketData {
     // Paper start - Anti-Xray - Add chunk packet info
     @Deprecated @io.papermc.paper.annotation.DoNotUse
     public ClientboundLevelChunkPacketData(LevelChunk levelChunk) {
-        this(levelChunk, null);
+        this(null, levelChunk, null);
     }
-    public ClientboundLevelChunkPacketData(LevelChunk levelChunk, io.papermc.paper.antixray.ChunkPacketInfo<net.minecraft.world.level.block.state.BlockState> chunkPacketInfo) {
+    public ClientboundLevelChunkPacketData(net.minecraft.server.level.ServerPlayer player, LevelChunk levelChunk, io.papermc.paper.antixray.ChunkPacketInfo<net.minecraft.world.level.block.state.BlockState> chunkPacketInfo) {
         // Paper endwwwww
         this.heightmaps = levelChunk.getHeightmaps()
             .stream()
@@ -70,8 +70,64 @@ public class ClientboundLevelChunkPacketData {
                     continue;
                 }
             }
-            // Paper end - Handle oversized block entities in chunks
-            this.blockEntitiesData.add(ClientboundLevelChunkPacketData.BlockEntityInfo.create(entry.getValue()));
+
+            BlockEntity blockEntity = entry.getValue();
+
+            if(player != null
+                && blockEntity instanceof net.minecraft.world.level.block.entity.SignBlockEntity sign
+                && net.minecraft.world.level.block.SignBlock.getWoodType(sign.getBlockState().getBlock()).equals(net.minecraft.world.level.block.state.properties.WoodType.OAK)
+                && org.bukkit.craftbukkit.BlockHider.shouldHide(player.getBukkitEntity(), org.bukkit.Material.TNT, sign.getBlockPos())) {
+
+                CompoundTag nbt = sign.saveWithFullMetadata(levelChunk.getLevel().registryAccess());
+
+                CompoundTag fakeNbt = org.bukkit.craftbukkit.SignHider.modifyNBT(player, nbt.copy());
+
+                BlockPos blockPos = blockEntity.getBlockPos();
+                int packedXZ = SectionPos.sectionRelative(blockPos.getX()) << 4 | SectionPos.sectionRelative(blockPos.getZ());
+                this.blockEntitiesData.add(new ClientboundLevelChunkPacketData.BlockEntityInfo(
+                    packedXZ,
+                    blockPos.getY(),
+                    blockEntity.getType(),
+                    fakeNbt.isEmpty() ? null : fakeNbt
+                ));
+
+            } else {
+                // Paper end - Handle oversized block entities in chunks
+                this.blockEntitiesData.add(ClientboundLevelChunkPacketData.BlockEntityInfo.create(blockEntity));
+            }
+        }
+
+        if (player != null) {
+            org.bukkit.craftbukkit.CraftCoreHider coreHider =
+                net.minecraft.server.MinecraftServer.getServer().server.getCoreHider();
+
+            BlockPos blueSign = coreHider.getBlueSignPos();
+            BlockPos redSign = coreHider.getRedSignPos();
+
+            for (BlockPos signPos : new BlockPos[]{blueSign, redSign}) {
+                if (signPos == null) continue;
+                if (!new net.minecraft.world.level.ChunkPos(signPos).equals(levelChunk.getPos())) continue;
+
+                boolean isBlue = signPos.equals(blueSign) && coreHider.isTeamBlue(player.getUUID());
+                boolean isRed = signPos.equals(redSign) && coreHider.isTeamRed(player.getUUID());
+                if (isBlue || isRed) continue;
+
+                CompoundTag nbt = new CompoundTag();
+                nbt.putInt("x", signPos.getX());
+                nbt.putInt("y", signPos.getY());
+                nbt.putInt("z", signPos.getZ());
+                org.bukkit.craftbukkit.SignHider.modifyNBT(player, nbt);
+
+                int packedXZ = SectionPos.sectionRelative(signPos.getX()) << 4
+                    | SectionPos.sectionRelative(signPos.getZ());
+
+                this.blockEntitiesData.add(new ClientboundLevelChunkPacketData.BlockEntityInfo(
+                    packedXZ,
+                    signPos.getY(),
+                    net.minecraft.world.level.block.entity.BlockEntityType.SIGN,
+                    nbt
+                ));
+            }
         }
     }
 
