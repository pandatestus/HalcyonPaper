+++ b/net/minecraft/server/level/HullHider.java
@@ -0,0 +1,497 @@
+package net.minecraft.server.level;
+
+public class HullHider {
+
+    private final ServerPlayer player;
+    private final PDCNodeReader reader;
+
+    private static @javax.annotation.Nullable HlcyRegion globalBlue;
+    private static @javax.annotation.Nullable HlcyRegion globalRed;
+
+    private boolean hullRegionBlue;
+    private boolean hullRegionRed;
+
+    private static final it.unimi.dsi.fastutil.objects.ObjectOpenHashSet<net.minecraft.core.BlockPos> unhiddenBlue = new it.unimi.dsi.fastutil.objects.ObjectOpenHashSet<>();
+    private static final it.unimi.dsi.fastutil.objects.ObjectOpenHashSet<net.minecraft.core.BlockPos> unhiddenRed = new it.unimi.dsi.fastutil.objects.ObjectOpenHashSet<>();
+
+    public HullHider(final ServerPlayer player, PDCNodeReader reader) {
+        this.player = player;
+        this.reader = reader;
+    }
+
+    public boolean shouldFillEndstone(net.minecraft.core.BlockPos pos) {
+        boolean isInsideBlue = hullRegionBlue && globalBlue != null && globalBlue.isInside(pos);
+        if (isInsideBlue) {
+            boolean containsBlue = !unhiddenBlue.isEmpty() && unhiddenBlue.contains(pos);
+            return !containsBlue;
+        }
+        boolean isInsideRed = hullRegionRed && globalRed != null && globalRed.isInside(pos);
+        if (isInsideRed) {
+            boolean containsRed = !unhiddenRed.isEmpty() && unhiddenRed.contains(pos);
+            return !containsRed;
+        }
+        return false;
+    }
+
+    private static final java.util.EnumSet<org.bukkit.Material> fallingBlocks = java.util.EnumSet.of(
+        org.bukkit.Material.GRAVEL, org.bukkit.Material.SUSPICIOUS_GRAVEL, org.bukkit.Material.SAND, org.bukkit.Material.SUSPICIOUS_SAND, org.bukkit.Material.RED_SAND,
+        org.bukkit.Material.BLACK_CONCRETE_POWDER, org.bukkit.Material.BLUE_CONCRETE_POWDER, org.bukkit.Material.BROWN_CONCRETE_POWDER, org.bukkit.Material.GRAY_CONCRETE_POWDER,
+        org.bukkit.Material.LIGHT_GRAY_CONCRETE_POWDER, org.bukkit.Material.LIGHT_BLUE_CONCRETE_POWDER, org.bukkit.Material.RED_CONCRETE_POWDER, org.bukkit.Material.YELLOW_CONCRETE_POWDER,
+        org.bukkit.Material.PURPLE_CONCRETE_POWDER, org.bukkit.Material.PINK_CONCRETE_POWDER, org.bukkit.Material.MAGENTA_CONCRETE_POWDER, org.bukkit.Material.CYAN_CONCRETE_POWDER,
+        org.bukkit.Material.LIME_CONCRETE_POWDER, org.bukkit.Material.GREEN_CONCRETE_POWDER, org.bukkit.Material.WHITE_CONCRETE_POWDER, org.bukkit.Material.ORANGE_CONCRETE_POWDER
+    );
+
+    private static final java.util.function.Predicate<org.bukkit.block.Block> isBlocked = block -> {
+        org.bukkit.Material type = block.getType();
+        if (type.isAir()) return false;
+        if (block.isLiquid()) return false;
+        if (fallingBlocks.contains(type)) return false;
+        if (type.isOccluding()) return true;
+        return Techhider.getHiderMaterials().contains(type);
+    };
+
+    private static final java.util.function.Predicate<net.minecraft.world.level.block.state.BlockState> isBlockedNMS = block -> {
+        org.bukkit.Material type = block.getBukkitMaterial();
+        if (type.isAir()) return false;
+        if (!block.getFluidState().isEmpty()) return false;
+        if (fallingBlocks.contains(type)) return false;
+        if (type.isOccluding()) return true;
+        return Techhider.getHiderMaterials().contains(type);
+    };
+
+    public static void applyRayTrace() {
+        org.bukkit.World world = org.bukkit.Bukkit.getWorld("world");
+        if (world == null) return;
+
+        boolean blueRegionNotSet = globalBlue == null;
+        boolean redRegionNotSet = globalRed == null;
+        if (blueRegionNotSet || redRegionNotSet) {
+            PDCNodeReader worldReader = new PDCNodeReader(world.getPersistentDataContainer());
+            if (blueRegionNotSet) globalBlue = worldReader.getRegion("hullhider", "blue");
+            if (redRegionNotSet) globalRed = worldReader.getRegion("hullhider", "red");
+
+            net.minecraft.server.MinecraftServer.LOGGER.info((globalBlue == null) + " " + (globalRed == null) + " reader " + worldReader.getRegion("hullhider", "blue"));
+        }
+
+        net.minecraft.server.MinecraftServer.LOGGER.info("calculating Hullhider");
+        long ns = System.nanoTime();
+
+        calculateBlue(world);
+        calculateRed(world);
+
+        for (ServerPlayer serverPlayer : net.minecraft.server.MinecraftServer.getServer().getPlayerList().players) {
+            serverPlayer.getBukkitEntity().getTechhider().update();
+        }
+
+        long nowNS = System.nanoTime();
+        long time = nowNS - ns;
+        net.minecraft.server.MinecraftServer.LOGGER.info("done calculating Hullhider, took " + String.format("%.3fms", time / 1_000_000.0));
+    }
