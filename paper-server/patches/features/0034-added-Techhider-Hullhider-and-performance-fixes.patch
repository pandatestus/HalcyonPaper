+            LOGGER.info("[TH] 9 after getBoolean");
+
+            LOGGER.info("[TH] 10 before type");
+
+            setType(
+                pdc.getOrDefault(
+                    OBFUSCATION_TYPE,
+                    org.bukkit.persistence.PersistentDataType.INTEGER,
+                    0
+                )
+            );
+
+            LOGGER.info("[TH] 11 after type");
+
+            this.noHideArea = reader.getRegion("techhider", "no-hide");
+
+            LOGGER.info("[TH] 12 after getRegion");
+
+            getHullHider().updateRegions();
+
+            LOGGER.info("[TH] 13 after updateRegions");
+
+            refreshRelevantChunks(player);
+
+            LOGGER.info("[TH] 14 finished");
+
+        } catch (Throwable e) {
+            LOGGER.error("[TH] Error while updating", e);
+        }
+    }
+
+    private void refreshRelevantChunks(org.bukkit.craftbukkit.entity.CraftPlayer player) {
+        net.minecraft.server.MinecraftServer.getServer().execute(() -> {
+            int viewDist = player.getWorld().getViewDistance();
+
+            int cx = player.getLocation().getBlockX() >> 4;
+            int cz = player.getLocation().getBlockZ() >> 4;
+
+            for (int x = cx - viewDist; x <= cx + viewDist; x++) {
+                for (int z = cz - viewDist; z <= cz + viewDist; z++) {
+                    if (player.getWorld().isChunkLoaded(x, z)) {
+                        player.getWorld().refreshChunk(x, z);
+                    }
+                }
+            }
+        });
+    }
+
+    public boolean shouldHideChunk(net.minecraft.world.level.chunk.LevelChunk chunk) {
+        if (hideNone) return false;
+
+        return noHideArea == null || !noHideArea.isInsideChunk(chunk);
+    }
+
+    public boolean shouldHideChunk(net.minecraft.core.BlockPos pos) {
+        if (hideNone) return false;
+
+        return noHideArea == null || !noHideArea.isInsideChunk(pos);
+    }
+
+    public net.minecraft.world.level.block.state.BlockState getObfuscationState() {
+        if (type == net.minecraft.server.level.Techhider.ObfuscationType.XRAY) return STRUCTURE_VOID;
+        return ENDSTONE;
+    }
+
+    public boolean isHidden(net.minecraft.world.level.block.state.BlockState state) {
+        if (type == net.minecraft.server.level.Techhider.ObfuscationType.XRAY)
+            return state.getBlock().defaultBlockState() == ENDSTONE;
+        if (state.hasProperty(net.minecraft.world.level.block.state.properties.BlockStateProperties.WATERLOGGED) && state.getValue(net.minecraft.world.level.block.state.properties.BlockStateProperties.WATERLOGGED))
+            return true;
+        return states.contains(state.getBlock());
+    }
+
+    public static boolean isStateHidden(net.minecraft.world.level.block.state.BlockState state) {
+        if (state.hasProperty(net.minecraft.world.level.block.state.properties.BlockStateProperties.WATERLOGGED) && state.getValue(net.minecraft.world.level.block.state.properties.BlockStateProperties.WATERLOGGED))
+            return true;
+        if (state.getBukkitMaterial().name().equalsIgnoreCase(org.bukkit.Material.MOVING_PISTON.name())) return true;
+        return states.contains(state.getBlock());
+    }
+
+    private enum ObfuscationType {
+        ENDSTONE_TECHHIDER,
+        XRAY
+    }
+}
