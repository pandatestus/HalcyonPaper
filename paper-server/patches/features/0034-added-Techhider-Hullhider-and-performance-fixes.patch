+                        tnt.getUUID(),
+                        tnt.getX(),
+                        tnt.getY(),
+                        tnt.getZ(),
+                        tnt.getXRot(),
+                        tnt.getYRot(),
+                        tnt.getType(),
+                        0,
+                        tnt.getDeltaMovement(),
+                        tnt.getYHeadRot()
+                    );
+                serverPlayer.connection.send(addPacket);
+                serverPlayer.connection.send(new net.minecraft.network.protocol.game.ClientboundSetEntityDataPacket(
+                    tnt.getId(), tnt.getEntityData().packAll()));
