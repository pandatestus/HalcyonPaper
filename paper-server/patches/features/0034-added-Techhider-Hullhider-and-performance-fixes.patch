diff --git a/net/minecraft/server/level/HlcyRegion.java b/net/minecraft/server/level/HlcyRegion.java
new file mode 100644
index 0000000000000000000000000000000000000000..812485a88724ffbee236d1225e3d935d59f37bca
--- /dev/null
+++ b/net/minecraft/server/level/HlcyRegion.java
@@ -0,0 +1,35 @@
+package net.minecraft.server.level;
+
+public record HlcyRegion(int minX, int minY, int minZ, int maxX, int maxY, int maxZ) {
+
+    public boolean isInside(net.minecraft.core.BlockPos pos) {
+        return pos.getX() >= minX && pos.getY() >= minY && pos.getZ() >= minZ && pos.getX() <= maxX && pos.getY() <= maxY && pos.getZ() <= maxZ;
+    }
+
+    public boolean isInsideChunk(net.minecraft.world.level.chunk.LevelChunk chunk) {
+        int chunkMinX = chunk.getPos().getMinBlockX();
+        int chunkMaxX = chunkMinX + 15;
+
+        int chunkMinZ = chunk.getPos().getMinBlockZ();
+        int chunkMaxZ = chunkMinZ + 15;
+
+        return chunkMaxX >= minX
+            && chunkMinX <= maxX
+            && chunkMaxZ >= minZ
+            && chunkMinZ <= maxZ;
+    }
+    public boolean isInsideChunk(net.minecraft.core.BlockPos pos) {
+        return pos.getX() >= minX && pos.getZ() >= minZ && pos.getX() <= maxX && pos.getZ() <= maxZ;
+    }
+    @Override
+    public String toString() {
+        return "HlcyRegion{" +
+            "minX=" + minX +
+            ", minY=" + minY +
+            ", minZ=" + minZ +
+            ", maxX=" + maxX +
+            ", maxY=" + maxY +
+            ", maxZ=" + maxZ +
+            '}';
+    }
+}
