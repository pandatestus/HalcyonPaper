+    private static final java.util.concurrent.ConcurrentMap<Integer, net.minecraft.world.entity.item.PrimedTnt> entityLookup = new java.util.concurrent.ConcurrentHashMap<>();
+
+    public static void tick() {
+        ServerLevel level = net.minecraft.server.MinecraftServer.getServer().overworld();
+        if (globalBlue == null || globalRed == null) return;
+
+        it.unimi.dsi.fastutil.ints.IntOpenHashSet currentlyHidden = new it.unimi.dsi.fastutil.ints.IntOpenHashSet();
+
+        java.util.List<net.minecraft.world.entity.item.PrimedTnt> blueTNT = getTntInRegion(level, globalBlue);
+        java.util.List<net.minecraft.world.entity.item.PrimedTnt> redTNT = getTntInRegion(level, globalRed);
+
+        // Statt sofort zu senden: IDs sammeln, die in diesem Tick NEU versteckt werden
+        it.unimi.dsi.fastutil.ints.IntArrayList newlyHiddenBlue = new it.unimi.dsi.fastutil.ints.IntArrayList();
+        it.unimi.dsi.fastutil.ints.IntArrayList newlyHiddenRed = new it.unimi.dsi.fastutil.ints.IntArrayList();
+
+        for (net.minecraft.world.entity.item.PrimedTnt tnt : blueTNT) {
+            if (unhiddenBlue.contains(tnt.blockPosition())) continue;
+
+            entityLookup.put(tnt.getId(), tnt);
+
+            if (currentlyHidden.add(tnt.getId())) {
+                newlyHiddenBlue.add(tnt.getId());
+            }
+        }
+
+        for (net.minecraft.world.entity.item.PrimedTnt tnt : redTNT) {
+            if (unhiddenRed.contains(tnt.blockPosition())) continue;
+
+            entityLookup.put(tnt.getId(), tnt);
+
+            if (currentlyHidden.add(tnt.getId())) {
+                newlyHiddenRed.add(tnt.getId());
+            }
+        }
+
+        // Jeweils EIN Batch-Packet pro Gruppe bauen und an die passenden Spieler schicken
+        if (!newlyHiddenBlue.isEmpty()) {
+            sendBatchHide(newlyHiddenBlue, serverPlayer ->
+                serverPlayer.getBukkitEntity().getTechhider().getHullHider().hullRegionBlue);
+        }
+        if (!newlyHiddenRed.isEmpty()) {
+            sendBatchHide(newlyHiddenRed, serverPlayer ->
+                serverPlayer.getBukkitEntity().getTechhider().getHullHider().hullRegionRed);
+        }
+
+        // Wieder sichtbare TNT sammeln
+        java.util.List<net.minecraft.world.entity.item.PrimedTnt> toShow = new java.util.ArrayList<>();
+        java.util.Iterator<Integer> it = entityLookup.keySet().iterator();
+        while (it.hasNext()) {
+            int id = it.next();
+            if (!currentlyHidden.contains(id)) {
+                net.minecraft.world.entity.item.PrimedTnt tnt = entityLookup.remove(id);
+                if (tnt != null && !tnt.isRemoved()) {
+                    toShow.add(tnt);
+                }
+                it.remove();
+            }
+        }
+
+        if (!toShow.isEmpty()) {
+            showEntitiesForPlayers(toShow);
+        }
+    }
+
+    private static void sendBatchHide(it.unimi.dsi.fastutil.ints.IntArrayList ids,
+                                      java.util.function.Predicate<ServerPlayer> shouldHideFor) {
+        it.unimi.dsi.fastutil.ints.IntList idList = new it.unimi.dsi.fastutil.ints.IntArrayList(ids.size());
+        for (int i = 0; i < ids.size(); i++) {
+            idList.add(ids.getInt(i));
+        }
+
+        net.minecraft.network.protocol.game.ClientboundRemoveEntitiesPacket packet =
+            new net.minecraft.network.protocol.game.ClientboundRemoveEntitiesPacket(idList);
+
+        for (ServerPlayer serverPlayer : net.minecraft.server.MinecraftServer.getServer().getPlayerList().getPlayers()) {
+            if (shouldHideFor.test(serverPlayer)) {
+                serverPlayer.connection.send(packet); // gleiches Packet-Objekt für alle passenden Spieler
+            }
+        }
+    }
