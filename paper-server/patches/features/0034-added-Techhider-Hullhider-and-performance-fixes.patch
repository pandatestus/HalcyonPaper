+    private static void showEntitiesForPlayers(java.util.List<net.minecraft.world.entity.item.PrimedTnt> tntList) {
+        for (ServerPlayer serverPlayer : net.minecraft.server.MinecraftServer.getServer().getPlayerList().getPlayers()) {
+            for (net.minecraft.world.entity.item.PrimedTnt tnt : tntList) {
+                net.minecraft.network.protocol.game.ClientboundAddEntityPacket addPacket =
+                    new net.minecraft.network.protocol.game.ClientboundAddEntityPacket(
